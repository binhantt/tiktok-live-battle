{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "TikTok Live Battle Arena - Backend Microservices (NestJS)",
  "scripts": {
    "build": "nest build api-gateway && nest build tiktok-connector && nest build event-worker && nest build battle-engine",
    "start:api": "node dist/apps/api-gateway/main.js",
    "start:connector": "node dist/apps/tiktok-connector/main.js",
    "start:worker": "node dist/apps/event-worker/main.js",
    "start:battle": "node dist/apps/battle-engine/main.js",
    "start:api:dev": "nest start api-gateway --watch",
    "start:connector:dev": "nest start tiktok-connector --watch",
    "start:worker:dev": "nest start event-worker --watch",
    "start:battle:dev": "nest start battle-engine --watch",
    "start:all:dev": "node scripts/start-dev.cjs",
    "simulate": "ts-node -r tsconfig-paths/register scripts/simulate-events.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    }
  }
}
